# Aves Assessment
NODE_ENV=production
APP_PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Database: postgres (default) or mysql
DB_DIALECT=postgres
COMPOSE_PROFILES=postgres

# PostgreSQL local default
POSTGRES_DB=aves_assessment
POSTGRES_USER=aves
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://aves:CHANGE_ME@db-postgres:5432/aves_assessment

# MySQL alternative (set DB_DIALECT=mysql and COMPOSE_PROFILES=mysql)
MYSQL_DATABASE=aves_assessment
MYSQL_USER=aves
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
# DATABASE_URL=mysql://aves:CHANGE_ME@db-mysql:3306/aves_assessment

# Security — generate unique values before production use
APP_ENCRYPTION_KEY=BASE64_32_BYTE_KEY
CRON_SECRET=CHANGE_ME
SESSION_TTL_HOURS=12

# First admin — removed/rotated after first login
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Local worker
ENABLE_LOCAL_NOTIFICATION_WORKER=true
